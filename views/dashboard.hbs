<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>NYX — Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Manrope:wght@200..800&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet"/>
<style>
    * { box-sizing: border-box; }
    body {
        margin: 0;
        min-height: 100vh;
        background: #141314;
        color: #e5e1e2;
        font-family: "Manrope", sans-serif;
        /* Safety net — no element on this page is meant to cause page-level
           horizontal scroll; the header is the one most likely to overflow on
           narrow screens if its content doesn't wrap. */
        overflow-x: hidden;
    }
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 40px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    header h1 {
        font-family: "Bodoni Moda", serif;
        font-size: 24px;
        letter-spacing: 0.1em;
        margin: 0;
        font-weight: 400;
    }
    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .back-btn {
        color: #c9c5cb;
        text-decoration: none;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 9999px;
        padding: 8px 16px;
        transition: border-color 0.25s ease, color 0.25s ease;
    }
    .back-btn:hover {
        border-color: #cdbefb;
        color: #cdbefb;
    }
    .who {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        color: #c9c5cb;
    }
    .role-badge {
        background: rgba(205, 190, 251, 0.12);
        color: #cdbefb;
        padding: 4px 12px;
        border-radius: 9999px;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
    .logout-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #e5e1e2;
        padding: 8px 18px;
        border-radius: 9999px;
        font-family: "Manrope", sans-serif;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
    }
    main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px;
    }
    .tabs {
        display: flex;
        gap: 12px;
        margin-bottom: 32px;
    }
    .mobile-tab-select {
        display: none;
    }
    .tab-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #c9c5cb;
        padding: 10px 22px;
        border-radius: 9999px;
        font-family: "Manrope", sans-serif;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
    }
    .tab-btn.active {
        border-color: #cdbefb;
        color: #cdbefb;
        background: rgba(205, 190, 251, 0.08);
    }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* ===== Precios: sub-tabs (Promociones / Precio / Descuento) ===== */
    .precios-subtabs {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
    }
    .precios-subtab-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #c9c5cb;
        padding: 8px 18px;
        border-radius: 9999px;
        font-family: "Manrope", sans-serif;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
    }
    .precios-subtab-btn.active {
        border-color: #cdbefb;
        color: #cdbefb;
        background: rgba(205, 190, 251, 0.08);
    }
    .precios-subpanel { display: none; }
    .precios-subpanel.active { display: block; }

    /* Mirrors the storefront's actual promo carousel styling, so this is a real
       preview of what the banner looks like, not just a text sample. */
    .promo-preview-box {
        background: linear-gradient(180deg, #141314 0%, #1c1140 35%, #2d1a4f 50%, #1c1140 65%, #141314 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 40px 24px;
        min-height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
    .promo-preview-text {
        font-family: "Bodoni Moda", serif;
        font-weight: 400;
        font-size: 22px;
        line-height: 1.3;
        color: #ffffff;
        margin: 0;
        transition: opacity 0.4s ease;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    .panel-header h2 {
        font-family: "Bodoni Moda", serif;
        font-weight: 400;
        font-size: 26px;
        margin: 0;
    }
    .primary-btn {
        background: #cdbefb;
        color: #1f1244;
        border: none;
        padding: 12px 24px;
        border-radius: 9999px;
        font-family: "Manrope", sans-serif;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }
    th, td {
        text-align: left;
        padding: 14px 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        vertical-align: top;
    }
    th {
        color: #c9c5cb;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 500;
    }
    td img {
        width: 48px;
        height: 64px;
        object-fit: cover;
        border-radius: 6px;
    }
    .no-photo {
        width: 48px;
        height: 64px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6e6a72;
        font-size: 10px;
    }
    .empty-row td {
        color: #6e6a72;
        text-align: center;
        padding: 40px 0;
    }

    .success {
        background: rgba(143, 224, 168, 0.1);
        border: 1px solid rgba(143, 224, 168, 0.3);
        color: #8fe0a8;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 20px;
    }
    .error {
        background: rgba(255, 180, 171, 0.1);
        border: 1px solid rgba(255, 180, 171, 0.3);
        color: #ffb4ab;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 20px;
    }

    .inline-form {
        display: flex;
        gap: 12px;
        align-items: end;
        flex-wrap: wrap;
        margin-bottom: 32px;
        padding: 20px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .field label {
        display: block;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #c9c5cb;
        margin-bottom: 6px;
    }
    input, select, textarea {
        width: 100%;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        padding: 10px 12px;
        color: #e5e1e2;
        font-family: "Manrope", sans-serif;
        font-size: 13px;
    }
    input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: #cdbefb;
    }

    #perfumeGender {
        background: #1c1b1c;
        border: 1.5px solid rgba(205, 190, 251, 0.5);
        color: #ffffff;
        font-weight: 600;
        cursor: pointer;
    }
    #perfumeGender option {
        background: #1c1b1c;
        color: #ffffff;
    }

    .form-row {
        display: flex;
        gap: 12px;
    }
    .form-row .field {
        flex: 1;
        min-width: 0;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 50;
        padding: 20px;
    }
    .modal-overlay.hidden { display: none; }
    .error.hidden, .success.hidden { display: none; }
    .modal-form {
        background: #1c1b1c;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 32px;
        width: 100%;
        max-width: 560px;
        max-height: 90vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .modal-form h3 {
        font-family: "Bodoni Moda", serif;
        font-weight: 400;
        margin: 0 0 8px;
        font-size: 22px;
    }
    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }
    .modal-actions button { flex: 1; }
    .cancel-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #e5e1e2;
        border-radius: 9999px;
        padding: 12px;
        font-family: "Manrope", sans-serif;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
    }

    .file-picker {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .file-picker input[type="file"] {
        display: none;
    }
    .file-picker-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(205, 190, 251, 0.1);
        border: 1px dashed rgba(205, 190, 251, 0.4);
        color: #cdbefb;
        border-radius: 8px;
        padding: 10px 16px;
        font-family: "Manrope", sans-serif;
        font-size: 12px;
        letter-spacing: 0.05em;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.2s ease, border-color 0.2s ease;
    }
    .file-picker-btn:hover {
        background: rgba(205, 190, 251, 0.18);
        border-color: #cdbefb;
    }
    .file-picker-name {
        font-size: 12px;
        color: #6e6a72;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .photo-preview {
        margin-top: 10px;
        width: 90px;
        height: 120px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .photo-preview.hidden {
        display: none;
    }

    .text-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #c9c5cb;
        border-radius: 9999px;
        padding: 6px 16px;
        font-family: "Manrope", sans-serif;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
    }
    .text-btn:hover {
        border-color: #ffb4ab;
        color: #ffb4ab;
    }
    .row-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 9999px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #c9c5cb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
    }
    .icon-btn .material-symbols-outlined {
        font-size: 16px;
    }
    .icon-btn.edit-btn:hover {
        border-color: #cdbefb;
        color: #cdbefb;
    }
    .icon-btn.delete-btn:hover {
        border-color: #ffb4ab;
        color: #ffb4ab;
    }

    .gender-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid transparent;
    }
    .gender-badge.masculino {
        background: rgba(107, 163, 230, 0.18);
        color: #8fc0f0;
        border-color: rgba(107, 163, 230, 0.4);
    }
    .gender-badge.femenino {
        background: rgba(230, 107, 168, 0.18);
        color: #f08fc0;
        border-color: rgba(230, 107, 168, 0.4);
    }
    .gender-badge.unisex {
        background: rgba(180, 140, 230, 0.18);
        color: #c9a8f0;
        border-color: rgba(180, 140, 230, 0.4);
    }

    .stock-check {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 700;
        color: #8fe0a8;
        background: rgba(143, 224, 168, 0.12);
        padding: 5px 12px;
        border-radius: 9999px;
    }
    .stock-check .material-symbols-outlined {
        font-size: 15px;
    }


    .autocomplete {
        position: relative;
    }
    .autocomplete-list {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #26252a;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        max-height: 180px;
        overflow-y: auto;
        z-index: 10;
    }
    .autocomplete-list.hidden {
        display: none;
    }
    .autocomplete-option {
        padding: 8px 12px;
        font-size: 13px;
        cursor: pointer;
    }
    .autocomplete-option:hover,
    .autocomplete-option.active {
        background: rgba(205, 190, 251, 0.12);
    }

    /* ===== Discount tools: perfume checklist + "currently discounted" list ===== */
    .discount-checklist {
        max-height: 260px;
        overflow-y: auto;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 6px;
        background: rgba(255, 255, 255, 0.02);
    }
    .discount-checklist-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        transition: background 0.15s ease;
    }
    .discount-checklist-item:hover {
        background: rgba(255, 255, 255, 0.05);
    }
    .discount-checklist-item.checked {
        background: rgba(205, 190, 251, 0.14);
    }
    .discount-checklist-item input[type="checkbox"] {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        accent-color: #cdbefb;
        cursor: pointer;
    }
    .discount-checklist-item .item-brand {
        color: #c9c5cb;
    }
    .discount-checklist-item .item-gender {
        margin-left: auto;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6e6a72;
        flex-shrink: 0;
    }

    .discounted-perfume-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }
    .discounted-perfume-row .row-name {
        flex: 1;
        min-width: 160px;
        font-size: 13px;
    }
    .discounted-perfume-row .row-name .row-brand {
        color: #cdbefb;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: block;
        margin-bottom: 2px;
    }
    .discounted-perfume-row .discount-pill {
        background: rgba(255, 180, 171, 0.14);
        color: #ffb4ab;
        font-weight: 700;
        font-size: 12px;
        padding: 4px 12px;
        border-radius: 9999px;
        flex-shrink: 0;
    }
    .discounted-perfume-row input[type="number"] {
        width: 70px;
        flex-shrink: 0;
    }

    .table-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }
    .table-controls .field {
        margin: 0;
    }
    .table-search {
        min-width: 240px;
    }

    .pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 16px;
        font-size: 12px;
        color: #c9c5cb;
        flex-wrap: wrap;
    }
    .pagination-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #e5e1e2;
        border-radius: 8px;
        padding: 8px 14px;
        font-family: "Manrope", sans-serif;
        font-size: 12px;
        cursor: pointer;
    }
    .pagination-btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }

    /* ===== Mobile table view — stacks each row into a labeled card instead of ===== */
    /* ===== squeezing a wide multi-column table into a narrow screen. ===== */
    @media (max-width: 700px) {
        .tabs {
            display: none;
        }
        .mobile-tab-select {
            display: block;
            width: 100%;
            margin-bottom: 24px;
            background: #1c1b1c;
            border: 1.5px solid rgba(205, 190, 251, 0.4);
            border-radius: 10px;
            padding: 12px 14px;
            color: #ffffff;
            font-family: "Manrope", sans-serif;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
        }
        .mobile-tab-select option {
            background: #1c1b1c;
            color: #ffffff;
        }
        /* Header was a single flex row (back button, title, email, role, logout) that
           never wrapped — on narrow screens that forced the whole page wider than the
           viewport. Wrap it onto two rows and shrink everything to fit instead. */
        header {
            flex-wrap: wrap;
            padding: 16px 20px;
            row-gap: 10px;
        }
        header h1 {
            font-size: 16px;
        }
        .header-left {
            gap: 10px;
        }
        .back-btn {
            padding: 6px 12px;
            font-size: 11px;
        }
        .who {
            width: 100%;
            justify-content: space-between;
            font-size: 11px;
            gap: 8px;
        }
        .who span:first-child {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            min-width: 0;
        }
        .role-badge {
            padding: 3px 10px;
            font-size: 10px;
            flex-shrink: 0;
        }
        .logout-btn {
            padding: 6px 12px;
            font-size: 10px;
            flex-shrink: 0;
        }
        table.responsive-table thead {
            display: none;
        }
        table.responsive-table, table.responsive-table tbody, table.responsive-table tr, table.responsive-table td {
            display: block;
            width: 100%;
        }
        table.responsive-table tr {
            margin-bottom: 14px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            padding: 4px 0;
            background: rgba(255, 255, 255, 0.02);
        }
        table.responsive-table tr.empty-row {
            padding: 20px 0;
        }
        table.responsive-table td {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 12px;
            text-align: right;
            padding: 10px 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        table.responsive-table td:last-child {
            border-bottom: none;
        }
        table.responsive-table td::before {
            content: attr(data-label);
            margin-right: auto;
            font-size: 11px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #c9c5cb;
            text-align: left;
            flex-shrink: 0;
        }
        table.responsive-table td:not([data-label])::before {
            content: none;
        }
        table.responsive-table tr.empty-row td {
            justify-content: center;
            text-align: center;
        }
        table.responsive-table tr.empty-row td::before {
            content: none;
        }
        table.responsive-table td img,
        table.responsive-table td .no-photo {
            margin-left: auto;
        }
        table.responsive-table td.row-actions {
            justify-content: flex-end;
        }
        /* Longer multi-line fields read better stacked than squeezed right-aligned. */
        table.responsive-table td[data-label="Notes"],
        table.responsive-table td[data-label="Description"] {
            flex-direction: column;
            align-items: flex-start;
            text-align: left;
        }
        table.responsive-table td[data-label="Notes"]::before,
        table.responsive-table td[data-label="Description"]::before {
            margin-right: 0;
            margin-bottom: 6px;
        }

        /* Collapsed-by-default rows — tap the card to reveal the rest of the fields
           (and the edit/delete actions) instead of showing everything at once. */
        table.responsive-table td.mobile-detail {
            display: none;
        }
        table.responsive-table tr.expanded td.mobile-detail {
            display: flex;
        }
        table.collapsible-table tr:not(.empty-row) {
            position: relative;
            cursor: pointer;
            padding-right: 30px;
        }
        table.collapsible-table tr:not(.empty-row)::after {
            content: "expand_more";
            font-family: "Material Symbols Outlined";
            position: absolute;
            top: 16px;
            right: 14px;
            color: #6e6a72;
            font-size: 18px;
            transition: transform 0.2s ease;
            pointer-events: none;
        }
        table.collapsible-table tr.expanded::after {
            transform: rotate(180deg);
        }
    }
</style>
</head>
<body>

<header>
<div class="header-left">
    <a href="/" class="back-btn">&larr; Inicio</a>
    <h1>NYX ADMIN</h1>
</div>
<div class="who">
    <span>{{email}}</span>
    <span class="role-badge">{{role}}</span>
    <form action="/logout" method="POST">
        <button type="submit" class="logout-btn">Log out</button>
    </form>
</div>
</header>

<main>
<div class="tabs">
    <button class="tab-btn" data-tab="inventario">Inventario</button>
    <button class="tab-btn" data-tab="catalogo">Catálogo</button>
    <button class="tab-btn" data-tab="precios">Precios</button>
    <button class="tab-btn" data-tab="marcas">Marcas</button>
