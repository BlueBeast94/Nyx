    function renderPromotionsTable() {
        promotionsTableBody.innerHTML = "";

        if (PROMOTIONS.length === 0) {
            promotionsTableBody.innerHTML = `<tr class="empty-row"><td colspan="2">No hay promociones. Agregá una arriba.</td></tr>`;
            return;
        }

        PROMOTIONS.forEach((promo) => {
