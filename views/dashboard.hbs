<script>
    // ===== Tabs (button row on desktop, dropdown on mobile — see .mobile-tab-select) =====
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabPanels = document.querySelectorAll(".tab-panel");
    const mobileTabSelect = document.getElementById("mobileTabSelect");

    function activateTab(name) {
        tabButtons.forEach((b) => b.classList.toggle("active", b.dataset.tab === name));
        tabPanels.forEach((p) => p.classList.toggle("active", p.id === name));
        mobileTabSelect.value = name;
    }

    tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            activateTab(btn.dataset.tab);
            history.replaceState(null, "", `#${btn.dataset.tab}`);
        });
    });

    mobileTabSelect.addEventListener("change", () => {
        activateTab(mobileTabSelect.value);
        history.replaceState(null, "", `#${mobileTabSelect.value}`);
    });

    const initialTab = window.location.hash.replace("#", "") || "inventario";
    activateTab(document.getElementById(initialTab) ? initialTab : "inventario");

    // ===== Precios: Promociones / Precio / Descuento sub-tabs =====
    const preciosSubtabButtons = document.querySelectorAll(".precios-subtab-btn");
    const preciosSubpanels = document.querySelectorAll(".precios-subpanel");

    function activatePreciosSubtab(name) {
        preciosSubtabButtons.forEach((b) => b.classList.toggle("active", b.dataset.subtab === name));
        preciosSubpanels.forEach((p) => p.classList.toggle("active", p.id === `preciosSub${name.charAt(0).toUpperCase()}${name.slice(1)}`));
    }

    preciosSubtabButtons.forEach((btn) => {
        btn.addEventListener("click", () => activatePreciosSubtab(btn.dataset.subtab));
    });

    activatePreciosSubtab("promociones");

    // ===== Mobile: tap a collapsed row to reveal its hidden (.mobile-detail) fields =====
    // and edit/delete actions. No-op on desktop, where .mobile-detail is always visible.
    function bindCollapsibleRow(tr) {
        tr.addEventListener("click", (e) => {
            if (e.target.closest("button, a, input, select, textarea, form")) return;
            tr.classList.toggle("expanded");
        });
    }

    // Marcas' rows are server-rendered and never re-rendered by JS, so bind them once here.
    // Inventario/Catálogo/Modelos rows are (re)built in JS and bind themselves on each render.
    document.querySelectorAll("#marcas table.collapsible-table tbody tr:not(.empty-row)").forEach(bindCollapsibleRow);

    // ===== Perfume modal (shared by Add + Edit) =====
    const perfumeModal = document.getElementById("perfumeModal");
    const perfumeForm = document.getElementById("perfumeForm");
    const perfumeModalTitle = document.getElementById("perfumeModalTitle");
    const perfumeSubmitBtn = document.getElementById("perfumeSubmitBtn");
    const photoInput = document.getElementById("perfumePhoto");
    const photoPickerBtn = document.getElementById("photoPickerBtn");
    const photoFileName = document.getElementById("photoFileName");
    const photoPreview = document.getElementById("photoPreview");

    function resetPhotoPicker() {
        photoFileName.textContent = "Sin archivo seleccionado";
        photoPreview.classList.add("hidden");
        photoPreview.src = "";
    }

    function openModalForCreate() {
        perfumeForm.reset();
        perfumeForm.action = "/dashboard/perfumes";
        perfumeModalTitle.textContent = "Add Perfume";
        perfumeSubmitBtn.textContent = "Save";
        resetPhotoPicker();
        perfumeModal.classList.remove("hidden");
    }

    function openModalForEdit(perfume) {
        perfumeForm.reset();
        perfumeForm.action = `/dashboard/perfumes/${perfume.id}`;
        perfumeModalTitle.textContent = "Edit Perfume";
        perfumeSubmitBtn.textContent = "Update";
        document.getElementById("perfumeBrand").value = perfume.brand || "";
        document.getElementById("perfumeModel").value = perfume.model || "";
        document.getElementById("perfumeGender").value = perfume.gender || "";
        document.getElementById("perfumeStockQuantity").value = perfume.stock_quantity ?? 0;
        document.getElementById("perfumePrice").value = perfume.price ?? "";
        document.getElementById("perfumeDiscount").value = perfume.discount_percent ?? "";
        document.getElementById("notesTop").value = perfume.notes_top || "";
        document.getElementById("notesMiddle").value = perfume.notes_middle || "";
        document.getElementById("notesBase").value = perfume.notes_base || "";
        document.getElementById("description").value = perfume.description || "";

        if (perfume.image_url) {
            photoFileName.textContent = "Foto actual (sin cambios)";
            photoPreview.src = perfume.image_url;
            photoPreview.classList.remove("hidden");
        } else {
            resetPhotoPicker();
