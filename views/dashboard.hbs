    const bulkPricingError = document.getElementById("bulkPricingError");

    function showBulkPricingResult(ok, text) {
        bulkPricingMsg.classList.toggle("hidden", !ok);
        bulkPricingError.classList.toggle("hidden", ok);
        (ok ? bulkPricingMsg : bulkPricingError).textContent = text;
    }

    bulkPriceForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const price = document.getElementById("bulkPriceInput").value;
        try {
            const res = await fetch("/dashboard/pricing/price", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ price })
            });
            if (!res.ok || isAuthRedirect(res)) throw new Error("request failed");
            const data = await res.json();
            showBulkPricingResult(true, `Precio actualizado en ${data.count} perfumes.`);
        } catch (err) {
            console.error("Failed to update bulk price:", err);
            showBulkPricingResult(false, "No se pudo actualizar el precio — tu sesión puede haber expirado. Recargá la página.");
        }
    });

    // ===== Descuentos por grupo: apply/clear a discount to perfumes matching a filter,
    // instead of needing to edit every single perfume by hand =====
    const discountFilterType = document.getElementById("discountFilterType");
    const discountGenderField = document.getElementById("discountGenderField");
    const discountBrandField = document.getElementById("discountBrandField");
    const discountPerfumesField = document.getElementById("discountPerfumesField");
    const discountBrandSelect = document.getElementById("discountBrandSelect");
    const discountPerfumesFilter = document.getElementById("discountPerfumesFilter");
    const discountPerfumesChecklist = document.getElementById("discountPerfumesChecklist");

    discountBrandSelect.innerHTML = ALL_BRANDS.map((name) => `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`).join("");

    // Checkboxes stay in the DOM (hidden via display, not removed) while filtering, so
    // ticked selections survive typing in the search box.
    function renderDiscountChecklist() {
        discountPerfumesChecklist.innerHTML = ALL_PERFUMES.map(
            (p) => `
                <label class="discount-checklist-item" data-search="${escapeHtml(`${p.brand} ${p.model}`.toLowerCase())}">
                    <input type="checkbox" value="${escapeHtml(p.id)}"/>
                    <span class="item-brand">${escapeHtml(p.brand)}</span> — ${escapeHtml(p.model)}
                    ${p.gender ? `<span class="item-gender">${escapeHtml(genderLabel(p.gender))}</span>` : ""}
                </label>
            `
        ).join("");

        discountPerfumesChecklist.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
            cb.addEventListener("change", () => {
                cb.closest(".discount-checklist-item").classList.toggle("checked", cb.checked);
            });
        });
    }
    renderDiscountChecklist();

    discountPerfumesFilter.addEventListener("input", () => {
        const term = discountPerfumesFilter.value.trim().toLowerCase();
        discountPerfumesChecklist.querySelectorAll("label").forEach((label) => {
            label.style.display = !term || label.dataset.search.includes(term) ? "flex" : "none";
        });
    });

    function updateDiscountFieldVisibility() {
        const type = discountFilterType.value;
        discountGenderField.style.display = type === "gender" ? "block" : "none";
        discountBrandField.style.display = type === "brand" ? "block" : "none";
        discountPerfumesField.style.display = type === "perfumes" ? "block" : "none";
    }
    discountFilterType.addEventListener("change", updateDiscountFieldVisibility);
    updateDiscountFieldVisibility();

    async function submitBulkDiscount(action) {
        const filterType = discountFilterType.value;
        let filterValue = "";
        if (filterType === "gender") {
            filterValue = document.getElementById("discountGenderSelect").value;
        } else if (filterType === "brand") {
            filterValue = discountBrandSelect.value;
        } else if (filterType === "perfumes") {
            filterValue = Array.from(discountPerfumesChecklist.querySelectorAll("input:checked"))
                .map((cb) => cb.value)
                .join(",");
            if (!filterValue) {
                showBulkPricingResult(false, "Tildá al menos un perfume.");
                return;
            }
        }

        const discountPercent = document.getElementById("discountPercentInput").value;
        if (action === "apply" && (discountPercent === "" || Number(discountPercent) <= 0)) {
            showBulkPricingResult(false, "Ingresá un porcentaje de descuento mayor a 0.");
            return;
        }

        try {
            const res = await fetch("/dashboard/pricing/discount", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ action, filterType, filterValue, discountPercent })
            });
            if (!res.ok || isAuthRedirect(res)) throw new Error("request failed");
            const data = await res.json();
            showBulkPricingResult(
                true,
                action === "apply"
                    ? `Descuento del ${discountPercent}% aplicado a ${data.count} perfumes.`
                    : `Descuento removido de ${data.count} perfumes.`
            );
            await refreshAllPerfumes();
        } catch (err) {
            console.error("Failed to update bulk discount:", err);
            showBulkPricingResult(false, "No se pudo actualizar el descuento — tu sesión puede haber expirado. Recargá la página.");
        }
    }

    document.getElementById("applyDiscountBtn").addEventListener("click", () => submitBulkDiscount("apply"));
    document.getElementById("clearDiscountBtn").addEventListener("click", () => submitBulkDiscount("clear"));

    // ===== "Perfumes con descuento actual" — so a discount set earlier (e.g. from a
    // group action) is still visible and editable afterward, one perfume at a time. =====
    async function refreshAllPerfumes() {
        try {
            const res = await fetch("/api/perfumes");
            const data = await res.json();
            if (Array.isArray(data)) {
                ALL_PERFUMES.length = 0;
                ALL_PERFUMES.push(...data);
            }
        } catch (err) {
            console.error("Failed to refresh perfumes:", err);
        }
        inventarioTable.render();
        catalogoTable.render();
        renderDiscountedPerfumesList();
    }

    function renderDiscountedPerfumesList() {
        const container = document.getElementById("discountedPerfumesList");
        const discounted = ALL_PERFUMES.filter((p) => p.discount_percent != null && p.discount_percent > 0);

        if (discounted.length === 0) {
            container.innerHTML = `<p style="font-size:13px;color:#6e6a72;">Ningún perfume tiene descuento activo.</p>`;
            return;
        }

        container.innerHTML = discounted
            .map(
                (p) => `
                    <div class="discounted-perfume-row" data-id="${escapeHtml(p.id)}">
                        <div class="row-name">
                            <span class="row-brand">${escapeHtml(p.brand)}</span>
                            ${escapeHtml(p.model)}
                        </div>
                        <span class="discount-pill">-${p.discount_percent}%</span>
                        <input type="number" min="0" max="100" step="1" class="discount-row-input" value="${p.discount_percent}"/>
                        <button type="button" class="text-btn update-discount-btn">Actualizar</button>
                        <button type="button" class="text-btn remove-discount-btn">Quitar</button>
                    </div>
                `
            )
            .join("");

        container.querySelectorAll(".update-discount-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const row = btn.closest(".discounted-perfume-row");
                applySingleDiscount(row.dataset.id, row.querySelector(".discount-row-input").value, "apply");
            });
        });
        container.querySelectorAll(".remove-discount-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                applySingleDiscount(btn.closest(".discounted-perfume-row").dataset.id, 0, "clear");
            });
        });
    }

    async function applySingleDiscount(id, discountPercent, action) {
        try {
            const res = await fetch("/dashboard/pricing/discount", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ action, filterType: "perfumes", filterValue: id, discountPercent })
            });
            if (!res.ok || isAuthRedirect(res)) throw new Error("request failed");
            showBulkPricingResult(true, action === "apply" ? "Descuento actualizado." : "Descuento removido.");
            await refreshAllPerfumes();
        } catch (err) {
            console.error("Failed to update discount:", err);
            showBulkPricingResult(false, "No se pudo actualizar — tu sesión puede haber expirado. Recargá la página.");
        }
    }

    renderDiscountedPerfumesList();
</script>

</body>
</html>
