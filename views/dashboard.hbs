                    <button type="button" class="text-btn delete-promotion-btn" data-id="${escapeHtml(promo.id)}">Eliminar</button>
                </td>
            `;
            tr.querySelector(".delete-promotion-btn").addEventListener("click", () => deletePromotion(promo.id));
            promotionsTableBody.appendChild(tr);
        });
    }

    // fetch() silently follows the /login redirect requireAuth issues on an expired
    // session and reports it as a 200 OK "success" — check the final URL too, or a
    // lapsed session would look like a successful save/delete that never happened.
    function isAuthRedirect(res) {
        return res.url.includes("/login");
    }

    async function deletePromotion(id) {
        if (!confirm("¿Eliminar esta promoción?")) return;
        try {
            const res = await fetch(`/dashboard/promotions/${id}/delete`, { method: "POST" });
            if (!res.ok || isAuthRedirect(res)) throw new Error("request failed");
            PROMOTIONS = PROMOTIONS.filter((p) => p.id !== id);
            renderPromotionsTable();
            promoPreviewIndex = 0;
            renderPromoPreview();
        } catch (err) {
            console.error("Failed to delete promotion:", err);
            alert("No se pudo eliminar la promoción — tu sesión puede haber expirado. Recargá la página e intentá de nuevo.");
        }
    }

    promotionForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const input = document.getElementById("newPromotionText");
        const text = input.value.trim();
        if (!text) return;

        promotionFormError.classList.add("hidden");
        try {
            const res = await fetch("/dashboard/promotions", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ text })
            });
            if (!res.ok || isAuthRedirect(res)) throw new Error("request failed");

            // The route redirects rather than returning JSON, so re-fetch the public list
            // to pick up the new row's real id (needed so its delete button works).
            const listRes = await fetch("/api/promotions");
            const data = await listRes.json();
            PROMOTIONS = Array.isArray(data.promotions) ? data.promotions : PROMOTIONS;

            input.value = "";
            renderPromotionsTable();
            promoPreviewIndex = 0;
            renderPromoPreview();
        } catch (err) {
            console.error("Failed to add promotion:", err);
            promotionFormError.textContent = "No se pudo agregar la promoción — tu sesión puede haber expirado. Recargá la página e intentá de nuevo.";
            promotionFormError.classList.remove("hidden");
        }
    });

    renderPromotionsTable();

    // Live preview of the storefront's promo carousel — cycles through PROMOTIONS the
    // same way the real banner does, so there's no need to open the site to check it.
    let promoPreviewIndex = 0;
    function renderPromoPreview() {
        const textEl = document.getElementById("promoPreviewText");
        if (!textEl) return;
        if (PROMOTIONS.length === 0) {
            textEl.textContent = "Agregá una promoción arriba para ver cómo se ve en la tienda.";
            return;
        }
        if (promoPreviewIndex >= PROMOTIONS.length) promoPreviewIndex = 0;
        textEl.textContent = PROMOTIONS[promoPreviewIndex].text;
    }
    setInterval(() => {
        promoPreviewIndex = (promoPreviewIndex + 1) % Math.max(PROMOTIONS.length, 1);
        renderPromoPreview();
    }, 3500);
    renderPromoPreview();

    // ===== Perfumes tables: filter + pagination (Inventario = in-stock only, Catálogo = all) =====
    const ALL_PERFUMES = JSON.parse(document.getElementById("perfumesData").textContent || "[]");

    function escapeHtml(str) {
        if (str == null) return "";
        return String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function genderLabel(gender) {
        if (gender === "masculino") return "Masculino";
        if (gender === "femenino") return "Femenino";
        if (gender === "unisex") return "Unisex";
        return "";
    }

    function deletePerfume(id) {
        if (!confirm("¿Eliminar este perfume? Esta acción no se puede deshacer.")) return;
        const form = document.createElement("form");
        form.method = "POST";
        form.action = `/dashboard/perfumes/${id}/delete`;
        document.body.appendChild(form);
        form.submit();
    }

    function submitQuantityUpdate(id, quantity) {
        const form = document.createElement("form");
        form.method = "POST";
        form.action = `/dashboard/perfumes/${id}/quantity`;
        const input = document.createElement("input");
        input.type = "hidden";
        input.name = "quantity";
        input.value = quantity;
        form.appendChild(input);
        document.body.appendChild(form);
        form.submit();
    }

    // ===== Catálogo: quantity-only edit modal =====
    const catalogQuantityModal = document.getElementById("catalogQuantityModal");
    const catalogQuantityPerfumeName = document.getElementById("catalogQuantityPerfumeName");
    const catalogQuantityInput = document.getElementById("catalogQuantityInput");
    const catalogQuantitySubmitBtn = document.getElementById("catalogQuantitySubmitBtn");
    let catalogQuantityEditId = null;

    function openCatalogQuantityModal(perfume) {
        catalogQuantityEditId = perfume.id;
        catalogQuantityPerfumeName.textContent = `${perfume.brand || ""} — ${perfume.model || ""}`;
        catalogQuantityInput.value = perfume.stock_quantity ?? 0;
        catalogQuantityModal.classList.remove("hidden");
    }

    document.getElementById("closeCatalogQuantityModal").addEventListener("click", () => {
        catalogQuantityModal.classList.add("hidden");
    });
    catalogQuantityModal.addEventListener("click", (e) => {
        if (e.target === catalogQuantityModal) catalogQuantityModal.classList.add("hidden");
    });
    catalogQuantitySubmitBtn.addEventListener("click", () => {
        if (!catalogQuantityEditId) return;
        submitQuantityUpdate(catalogQuantityEditId, catalogQuantityInput.value);
    });

    function createPerfumeTable({ idPrefix, filterSource, compact, mode }) {
        const tableBody = document.getElementById(`${idPrefix}TableBody`);
        const filterInput = document.getElementById(`${idPrefix}Filter`);
        const pageSizeSelect = document.getElementById(`${idPrefix}PageSize`);
        const prevBtn = document.getElementById(`${idPrefix}PrevBtn`);
        const nextBtn = document.getElementById(`${idPrefix}NextBtn`);
        const summary = document.getElementById(`${idPrefix}Summary`);
        const indicator = document.getElementById(`${idPrefix}Indicator`);
        const colCount = compact ? 6 : 8;

        let currentPage = 1;

        function getFiltered() {
            const source = filterSource ? ALL_PERFUMES.filter(filterSource) : ALL_PERFUMES;
            const term = filterInput.value.trim().toLowerCase();
            if (!term) return source;
            return source.filter((p) =>
                [p.brand, p.model, p.gender].some((f) => (f || "").toLowerCase().includes(term))
            );
        }

        function render() {
            const pageSize = parseInt(pageSizeSelect.value, 10);
            const filtered = getFiltered();
            const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
            currentPage = Math.min(currentPage, totalPages);

            const start = (currentPage - 1) * pageSize;
            const pageItems = filtered.slice(start, start + pageSize);

            tableBody.innerHTML = "";

            if (pageItems.length === 0) {
                tableBody.innerHTML = `<tr class="empty-row"><td colspan="${colCount}">No hay perfumes.</td></tr>`;
            } else {
                pageItems.forEach((p) => {
                    const tr = document.createElement("tr");
                    tr.innerHTML = `
                        <td data-label="Photo">${p.image_url ? `<img src="${escapeHtml(p.image_url)}" alt="${escapeHtml(p.model)}"/>` : `<div class="no-photo">N/A</div>`}</td>
                        <td data-label="Marca">${escapeHtml(p.brand)}</td>
                        <td data-label="Modelo">${escapeHtml(p.model)}</td>
                        <td data-label="Género" class="mobile-detail">${p.gender ? `<span class="gender-badge ${escapeHtml(p.gender)}">${escapeHtml(genderLabel(p.gender))}</span>` : ""}</td>
                        <td data-label="En Stock" class="mobile-detail">${p.stock_quantity >= 1 ? `<span class="stock-check"><span class="material-symbols-outlined">check_circle</span>${p.stock_quantity}</span>` : ""}</td>
                        ${
                            compact
                                ? ""
                                : `<td data-label="Notes" class="mobile-detail">Top: ${escapeHtml(p.notes_top)}<br/>Middle: ${escapeHtml(p.notes_middle)}<br/>Base: ${escapeHtml(p.notes_base)}</td>
                                   <td data-label="Description" class="mobile-detail">${escapeHtml(p.description)}</td>`
                        }
                        <td class="row-actions mobile-detail">
                            <button type="button" class="icon-btn edit-btn" data-id="${escapeHtml(p.id)}" aria-label="Editar" title="Editar">
                                <span class="material-symbols-outlined">edit</span>
                            </button>
                            ${
                                mode === "catalog"
                                    ? ""
                                    : `<button type="button" class="icon-btn delete-btn" data-id="${escapeHtml(p.id)}" aria-label="Eliminar" title="Eliminar">
                                        <span class="material-symbols-outlined">delete</span>
                                       </button>`
                            }
                        </td>
                    `;
                    bindCollapsibleRow(tr);
                    tableBody.appendChild(tr);
                });
            }

            tableBody.querySelectorAll(".edit-btn").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const perfume = ALL_PERFUMES.find((p) => p.id === btn.dataset.id);
                    if (!perfume) return;
                    if (mode === "catalog") {
                        openCatalogQuantityModal(perfume);
                    } else {
                        openModalForEdit(perfume);
                    }
                });
            });
            tableBody.querySelectorAll(".delete-btn").forEach((btn) => {
                btn.addEventListener("click", () => deletePerfume(btn.dataset.id));
            });

            const rangeStart = filtered.length === 0 ? 0 : start + 1;
            const rangeEnd = Math.min(start + pageSize, filtered.length);
            summary.textContent = `Mostrando ${rangeStart}-${rangeEnd} de ${filtered.length}`;
            indicator.textContent = `Página ${currentPage} de ${totalPages}`;
            prevBtn.disabled = currentPage <= 1;
            nextBtn.disabled = currentPage >= totalPages;
        }

        filterInput.addEventListener("input", () => {
            currentPage = 1;
            render();
        });
        pageSizeSelect.addEventListener("change", () => {
            currentPage = 1;
            render();
        });
        prevBtn.addEventListener("click", () => {
            currentPage -= 1;
            render();
        });
        nextBtn.addEventListener("click", () => {
            currentPage += 1;
            render();
        });

        return { render };
    }

    const inventarioTable = createPerfumeTable({
        idPrefix: "inventario",
        filterSource: (p) => p.stock_quantity >= 1,
        mode: "full"
