<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>NYX — Login</title>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Manrope:wght@200..800&display=swap" rel="stylesheet"/>
<style>
    * { box-sizing: border-box; }
    body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #141314;
        color: #e5e1e2;
        font-family: "Manrope", sans-serif;
    }
    .card {
        width: 100%;
        max-width: 360px;
        padding: 40px;
        text-align: center;
    }
    h1 {
        font-family: "Bodoni Moda", serif;
        font-size: 40px;
        letter-spacing: 0.05em;
        margin: 0 0 8px;
        font-weight: 400;
    }
    p.subtitle {
        color: #c9c5cb;
        font-size: 13px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin: 0 0 32px;
    }
    form {
        display: flex;
        flex-direction: column;
        gap: 16px;
        text-align: left;
    }
    label {
        font-size: 11px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #c9c5cb;
        margin-bottom: 6px;
        display: block;
    }
    input {
        width: 100%;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        padding: 12px 14px;
        color: #e5e1e2;
        font-family: "Manrope", sans-serif;
        font-size: 14px;
    }
    input:focus {
        outline: none;
        border-color: #cdbefb;
    }
    button {
        margin-top: 8px;
        padding: 14px;
        border-radius: 9999px;
        border: none;
        background: #cdbefb;
        color: #1f1244;
        font-family: "Manrope", sans-serif;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-size: 12px;
        cursor: pointer;
    }
    .error {
        background: rgba(255, 180, 171, 0.1);
        border: 1px solid rgba(255, 180, 171, 0.3);
        color: #ffb4ab;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 13px;
    }
    .back-btn {
        display: inline-block;
        color: #c9c5cb;
        text-decoration: none;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 9999px;
        padding: 8px 16px;
        margin-bottom: 28px;
        transition: border-color 0.25s ease, color 0.25s ease;
    }
    .back-btn:hover {
        border-color: #cdbefb;
        color: #cdbefb;
    }
</style>
</head>
<body>
<div class="card">
    <a href="/" class="back-btn">&larr; Inicio</a>
    <h1>NYX</h1>
    <p class="subtitle">Admin Login</p>
    {{#if error}}
    <p class="error">{{error}}</p>
    {{/if}}
    <form action="/login" method="POST">
        <div>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required/>
        </div>
        <div>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required/>
        </div>
        <button type="submit">Sign In</button>
    </form>
</div>
</body>
</html>
